<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded focus notification: the habit, a big countdown, and Pause or Resume, and Done.
     Android draws the app name and the expand arrow above it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingTop="4dp"
  android:paddingBottom="4dp">

  <TextView
    android:id="@+id/focus_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
    android:maxLines="1"
    android:ellipsize="end" />

  <Chronometer
    android:id="@+id/focus_clock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
    android:textSize="44sp"
    android:fontFeatureSettings="tnum" />

  <TextView
    android:id="@+id/focus_paused_clock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
    android:textSize="44sp"
    android:fontFeatureSettings="tnum"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="4dp">

    <Button
      android:id="@+id/focus_pause"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_marginEnd="4dp"
      android:text="Pause" />

    <Button
      android:id="@+id/focus_done"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_marginStart="4dp"
      android:text="Done" />
  </LinearLayout>
</LinearLayout>
