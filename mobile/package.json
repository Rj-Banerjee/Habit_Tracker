{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.22",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "preset": "jest-expo/ios",
        "testPathIgnorePatterns": [
          "\\.web\\.test\\.tsx$",
          "/node_modules/"
        ]
      },
      {
        "preset": "jest-expo/android",
        "testPathIgnorePatterns": [
          "\\.web\\.test\\.tsx$",
          "/node_modules/"
        ]
      },
      {
        "preset": "jest-expo/web",
        "testMatch": [
          "**/*.web.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/web.setup.js"
        ],
        "moduleNameMapper": {
          "^@react-native/assets-registry/registry$": "<rootDir>/test/assetRegistryStub.js"
        }
      }
    ]
  }
}
