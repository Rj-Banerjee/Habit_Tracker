# Server only. Never copy these into frontend or mobile code.
# The FastAPI AI service will read these in Step 2 item 6.

# Supabase Postgres connection string.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase project URL and secret key.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Clients use this key too, so it isn't secret. The AI service reads data with it
# plus the signed-in person's own token, so RLS still applies.
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# AI provider. Switching provider means changing only this block.
AI_PROVIDER="gemini"
AI_MODEL_FAST="gemini-3.5-flash-lite"
AI_MODEL_STRONG="gemini-3.6-flash"
GEMINI_API_KEY=""

# Offline on your Mac instead:
# AI_PROVIDER="ollama"
# AI_MODEL_FAST="your-small-model"
# AI_MODEL_STRONG="your-larger-model"

# "free" lets only the test accounts below reach the provider. Production must be
# a paid tier with no training on user data. See "AI data" in PLAN.md.
AI_PROVIDER_TIER="free"
AI_TEST_USER_IDS=""

AI_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"
